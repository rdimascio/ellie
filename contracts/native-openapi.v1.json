{
  "openapi": "3.1.0",
  "info": {
    "title": "Ellie native client enrollment API",
    "version": "1.0.0",
    "description": "The optional client HTTPS listener exposes only native enrollment/session/logout here. Use the exact origin from the explicitly confirmed QR. Verify its leaf SHA-256, hostname and certificate validity. Native bearer credentials never authenticate as coordinator, execution-node or browser credentials. No cookies, Origin or Sec-Fetch-* headers are allowed; Host must match the exact listener authority. JSON POST bodies require a single application/json Content-Type, optionally charset=utf-8. No automatic mutation replay is permitted."
  },
  "servers": [
    {
      "url": "{origin}",
      "variables": {
        "origin": {
          "default": "https://coordinator.example:8444",
          "description": "Reserved example only. Replace with the verified QR origin; never infer the coordinator API port."
        }
      }
    }
  ],
  "security": [
    {
      "nativeBearer": []
    }
  ],
  "paths": {
    "/native/v1/pair": {
      "post": {
        "parameters": [
          {
            "name": "X-Ellie-Version",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "const": "1"
            }
          }
        ],
        "x-ellie-max-json-post-body-bytes": 4096,
        "x-ellie-request-channel": {
          "exactHost": true,
          "forbiddenHeaders": [
            "Origin",
            "Cookie",
            "Sec-Fetch-*"
          ],
          "duplicateHeadersRejected": [
            "Host",
            "Authorization",
            "X-Ellie-Version"
          ],
          "jsonPostRequiresSingleContentType": true
        },
        "operationId": "pairNativeClient",
        "security": [],
        "summary": "Exchange a single-use invitation for a native session",
        "description": "Authorization is forbidden. Generate and safely retain a random candidate token before the single POST. Success means durable pairing committed. An interrupted response is uncertain: use GET session with the candidate to recover, never replay this POST automatically.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NativePairRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Pairing durably committed. No credential is returned; the client already holds its candidate.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NativeSessionResponse"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            }
          },
          "400": {
            "description": "Request rejected by the native listener.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NativeError"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            }
          },
          "401": {
            "description": "Native credential rejected or expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NativeError"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            }
          },
          "403": {
            "description": "Request rejected by the native listener.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NativeError"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            }
          },
          "404": {
            "description": "Request rejected by the native listener.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NativeError"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            }
          },
          "415": {
            "description": "Request rejected by the native listener.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NativeError"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            }
          },
          "500": {
            "description": "Authorization persistence or listener unavailable; a mutation outcome may be uncertain.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NativeError"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            }
          },
          "503": {
            "description": "Authorization persistence or listener unavailable; a mutation outcome may be uncertain.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NativeError"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            }
          }
        }
      }
    },
