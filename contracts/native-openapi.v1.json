                "schema": {
                  "const": "no-store"
                }
              }
            }
          },
          "401": {
            "description": "Native credential rejected or expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NativeError"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            }
          },
          "403": {
            "description": "Request rejected by the native listener.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NativeError"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            }
          },
          "404": {
            "description": "Request rejected by the native listener.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NativeError"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            }
          },
          "415": {
            "description": "Request rejected by the native listener.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NativeError"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            }
          },
          "500": {
            "description": "Authorization persistence or listener unavailable; a mutation outcome may be uncertain.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NativeError"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            }
          },
          "503": {
            "description": "Authorization persistence or listener unavailable; a mutation outcome may be uncertain.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NativeError"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            }
          }
        }
      }
    },
    "/native/v1/logout": {
      "post": {
        "parameters": [
          {
            "name": "X-Ellie-Version",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "const": "1"
            }
          }
        ],
        "x-ellie-max-json-post-body-bytes": 4096,
        "x-ellie-request-channel": {
          "exactHost": true,
          "forbiddenHeaders": [
            "Origin",
            "Cookie",
            "Sec-Fetch-*"
          ],
          "duplicateHeadersRejected": [
            "Host",
            "Authorization",
            "X-Ellie-Version"
          ],
          "jsonPostRequiresSingleContentType": true
        },
        "operationId": "logoutNativeClient",
        "summary": "Revoke this native credential",
        "description": "The empty JSON body is required. Success confirms durable revocation. On interruption retain uncertainty; GET session may resolve whether the credential still authenticates. Local credential removal alone does not confirm server revocation.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NativeLogoutRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Native credential durably revoked.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NativeLogoutResponse"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            }
          },
          "400": {
            "description": "Request rejected by the native listener.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NativeError"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            }
          },
          "401": {
            "description": "Native credential rejected or expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NativeError"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            }
          },
          "403": {
            "description": "Request rejected by the native listener.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NativeError"
                }
              }
            },
            "headers": {
              "Cache-Control": {
