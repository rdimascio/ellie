{
  "name": "ellie-workspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "ellie": "node apps/cli/src/main.ts",
    "lint": "oxlint . --deny-warnings",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit && tsc --project apps/command-center/tsconfig.json && tsc --project apps/life-ui/tsconfig.json",
    "test": "node --test tests/*.test.ts scripts/ios-doctor.test.mjs",
    "check": "bun run lint && bun run format:check && bun run contracts:check && bun run typecheck && bun run test && bun run demo:build && bun run life:build",
    "life:build": "node node_modules/vite/bin/vite.js build --config apps/life-ui/vite.config.ts",
    "life:start": "node apps/life/src/main.ts",
    "life:test": "bun run life:build && node apps/life-ui/tests/life.e2e.ts",
    "life:design-preview": "bun run life:build && node apps/life-ui/tests/design-preview.ts",
    "life:test:design": "bun run life:build && node --test apps/life-ui/tests/financial-insights.test.ts apps/life-ui/tests/mobile-design-cleanup.test.ts && node apps/life-ui/tests/mobile-design.e2e.ts",
    "life:test:mobile-orb": "bun run life:build && node apps/life-ui/tests/mobile-orb.e2e.ts",
    "life:test:connections": "bun run life:build && node apps/life-ui/tests/connections.e2e.ts",
    "life:test:native": "bun run life:build && node apps/life-ui/tests/native.e2e.ts",
    "life:quality": "node scripts/life-quality-lab.ts",
    "improvement:queue": "node scripts/improvement-queue.ts",
    "life:quality:browser": "bun run life:build && node scripts/life-browser-quality.ts",
    "life": "bun run life:build && bun run life:start",
    "build:macos": "node scripts/build-macos.mjs",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:package": "node scripts/package-desktop.mjs",
    "services:package": "node scripts/build-service-payload.mjs",
    "services:test-packaged-runtime": "node scripts/test-packaged-runtime.mjs",
    "services:test-runtime-rollback": "node scripts/test-runtime-rollback.mjs",
    "desktop:test": "node scripts/test-desktop.mjs",
    "ios:doctor": "node scripts/ios-doctor.mjs",
    "ios:build": "xcodebuild -project apps/ios/EllieIOS.xcodeproj -scheme EllieIOS -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' CODE_SIGNING_ALLOWED=NO build",
    "ios:test": "node scripts/test-ios.mjs",
    "contracts:generate": "node scripts/generate-contracts.ts",
    "contracts:check": "node scripts/generate-contracts.ts --check",
    "smoke:macos": "node scripts/smoke-macos.mjs",
    "smoke:services": "node scripts/smoke-services.mjs",
    "demo": "bun run demo:build && bun run demo:preview",
    "demo:build": "node node_modules/vite/bin/vite.js build --config apps/command-center/vite.config.ts",
    "demo:preview": "node node_modules/vite/bin/vite.js preview --config apps/command-center/vite.config.ts",
    "demo:test": "node node_modules/@playwright/test/cli.js test --config apps/command-center/playwright.config.ts",
    "test:ios-ats": "node scripts/test-ios-ats.mjs",
    "test:browser-media": "node --test browser-media-tests/browser-media-extension.test.ts",
    "accept:browser-webmcp": "node scripts/browser-webmcp-acceptance.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "agent-browser": "0.37.1",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "typescript": "^5.9.0",
    "vite": "8.3.0"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "bun@1.4.2"
}
