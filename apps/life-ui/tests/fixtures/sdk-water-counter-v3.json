{
  "name": "Water Counter Widget",
  "description": "A simple water counter widget that tracks glasses of water consumed. Users can add a glass or reset the count. The value persists across sessions using secure storage with a calm blue design and large, readable numbers. Reset now works without modals, using direct zero save and safe integer validation. All alerts and confirms are removed.",
  "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n<title>Water Counter</title>\n<style>\n  body {\n    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n    background: #e6f7ff;\n    color: #0a5f8a;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    height: 100vh;\n    margin: 0;\n    padding: 20px;\n    box-sizing: border-box;\n  }\n  .container {\n    background: white;\n    padding: 30px;\n    border-radius: 16px;\n    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);\n    text-align: center;\n    max-width: 300px;\n    width: 100%;\n  }\n  h1 {\n    margin: 0 0 20px;\n    font-size: 1.5rem;\n    color: #0a5f8a;\n  }\n  .count {\n    font-size: 4rem;\n    font-weight: bold;\n    margin: 10px 0;\n    color: #0a5f8a;\n    min-height: 60px;\n  }\n  button {\n    padding: 12px 20px;\n    margin: 10px;\n    font-size: 1rem;\n    border: none;\n    border-radius: 8px;\n    cursor: pointer;\n    transition: background 0.3s ease;\n    font-weight: bold;\n  }\n  .add {\n    background: #0a5f8a;\n    color: white;\n  }\n  .add:hover {\n    background: #004060;\n  }\n  .reset {\n    background: #d0d0d0;\n    color: #0a5f8a;\n  }\n  .reset:hover {\n    background: #b0b0b0;\n  }\n  .error {\n    color: #d9534f;\n    font-size: 0.9rem;\n    margin: 10px 0;\n    display: none;\n  }\n  .loading {\n    opacity: 0.5;\n    cursor: not-allowed;\n  }\n</style>\n</head>\n<body>\n  <div class=\"container\">\n    <h1>💧 Water Tracker</h1>\n    <div class=\"count\" id=\"count\">0</div>\n    <div class=\"error\" id=\"error\">Failed to load data. Click Retry to try again.</div>\n    <button class=\"add\" id=\"addGlass\" disabled>Add a glass</button>\n    <button class=\"reset\" id=\"resetCount\" disabled>Reset</button>\n  </div>\n\n  <script>\n    let count = 0;\n    const countElement = document.getElementById('count');\n    const addGlassButton = document.getElementById('addGlass');\n    const resetButton = document.getElementById('resetCount');\n    const errorElement = document.getElementById('error');\n\n    // Disable buttons initially\n    addGlassButton.disabled = true;\n    resetButton.disabled = true;\n\n    // Load saved count\n    async function load() {\n      try {\n        const saved = await window.ellie.storage.get('waterCount');\n        if (saved !== null) {\n          const parsed = Number.isSafeInteger(Number.parseInt(saved, 10));\n          count = parsed ? Number.parseInt(saved, 10) : 0;\n        }\n        countElement.textContent = count;\n      } catch (error) {\n        console.error('Failed to load count:', error);\n        errorElement.style.display = 'block';\n        return;\n      }\n      addGlassButton.disabled = false;\n      resetButton.disabled = false;\n    }\n\n    // Save count\n    async function save(next) {\n      addGlassButton.disabled = true;\n      resetButton.disabled = true;\n      try {\n        await window.ellie.storage.set('waterCount', next);\n        count = next;\n        countElement.textContent = next;\n      } catch (error) {\n        console.error('Failed to save count:', error);\n        errorElement.textContent = 'Failed to save your progress. Please try again.';\n        errorElement.style.display = 'block';\n      } finally {\n        addGlassButton.disabled = false;\n        resetButton.disabled = false;\n      }\n    }\n\n    // Initialize\n    load().catch(console.error);\n\n    // Add glass\n    addGlassButton.addEventListener('click', async () => {\n      await save(count + 1);\n    });\n\n    // Reset\n    resetButton.addEventListener('click', async () => {\n      await save(0);\n    });\n\n    // Retry loading\n    errorElement.addEventListener('click', async () => {\n      errorElement.style.display = 'none';\n      await load();\n    });\n  </script>\n</body>\n</html>"
}